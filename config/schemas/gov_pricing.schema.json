{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tender Export OS GOV Pricing Draft Contract",
  "description": "Citation-first internal GOV pricing draft. It intentionally cannot authorize a final bid price.",
  "schema_version": "gov_pricing.v1",
  "required_top_level": [
    "schema_version",
    "case_id",
    "workflow_type",
    "generated_at",
    "supplier_gate_status",
    "supplier_quote_proofs",
    "cost_waterfall",
    "working_capital",
    "l1_sensitivity",
    "margin_scenarios",
    "assumptions",
    "source_dates",
    "unresolved_items",
    "pricing_status",
    "final_bid_price_inr",
    "external_actions_executed"
  ],
  "required_component_keys": [
    "supplier_base_cost",
    "gst",
    "freight",
    "packaging",
    "installation",
    "warranty_reserve",
    "documentation",
    "portal_fee",
    "document_fee",
    "bid_submission_fee",
    "emd_opportunity_cost",
    "pbg_cost",
    "working_capital_financing",
    "payment_delay_buffer",
    "penalty_reserve",
    "risk_buffer",
    "margin"
  ],
  "component_statuses": ["OBSERVED", "ASSUMED", "UNKNOWN", "NOT_APPLICABLE"],
  "pricing_statuses": ["DRAFT_READY", "BLOCKED"],
  "prohibited_keys": ["password", "token", "cookie", "session", "bank_details", "dsc", "raw_quote_text"]
}
