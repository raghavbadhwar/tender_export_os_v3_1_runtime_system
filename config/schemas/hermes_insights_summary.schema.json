{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tender-export-os.local/schemas/hermes_insights_summary.schema.json",
  "title": "Hermes Insights aggregate summary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "generated_at", "period", "metrics", "source_output_sha256", "raw_output_persisted"],
  "properties": {
    "schema_version": {"const": "hermes_insights_summary.v1"},
    "profile": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "period": {"type": "string", "minLength": 1},
    "source_output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "raw_output_persisted": {"const": false},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessions", "messages", "tool_calls", "input_tokens", "output_tokens", "total_tokens", "models", "tools", "skills"],
      "properties": {
        "sessions": {"type": "integer", "minimum": 0},
        "messages": {"type": "integer", "minimum": 0},
        "user_messages": {"type": "integer", "minimum": 0},
        "tool_calls": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "models": {"type": "array", "items": {"$ref": "#/$defs/ranked_metric"}},
        "tools": {"type": "array", "items": {"$ref": "#/$defs/ranked_metric"}},
        "skills": {"type": "array", "items": {"$ref": "#/$defs/ranked_metric"}}
      }
    }
  },
  "$defs": {
    "ranked_metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "count"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "count": {"type": "integer", "minimum": 0},
        "tokens": {"type": "integer", "minimum": 0},
        "percentage": {"type": "number", "minimum": 0, "maximum": 100},
        "edits": {"type": "integer", "minimum": 0},
        "last_used": {"type": "string"}
      }
    }
  }
}
