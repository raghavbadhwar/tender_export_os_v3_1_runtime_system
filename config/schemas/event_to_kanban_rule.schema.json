{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tender-export-os.local/schemas/event_to_kanban_rule.schema.json",
  "title": "Tender OS Event-to-Kanban Rule Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "board", "route_via", "external_effects_allowed", "rules"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "board": {"const": "tender-export-os"},
    "route_via": {"const": "teos-orchestrator"},
    "external_effects_allowed": {"const": false},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "event_types", "profile", "title", "priority", "case_id_required", "payload_match", "evidence_fields"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "event_types": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "profile": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "priority": {"type": "integer", "minimum": 1, "maximum": 100},
          "case_id_required": {"type": "boolean"},
          "payload_match": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
          "evidence_fields": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
