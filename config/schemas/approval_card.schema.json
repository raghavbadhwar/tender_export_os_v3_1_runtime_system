{
  "title": "Tender Export OS Approval Card",
  "type": "object",
  "required": [
    "approval_id",
    "case_id",
    "workflow_type",
    "proposed_action",
    "business_object",
    "amount_or_price",
    "expected_benefit",
    "concrete_risk",
    "recovery_rollback_path",
    "documents_sources_used",
    "confidence_score",
    "missing_information",
    "approval_options",
    "requested_at",
    "approval_timeout_at",
    "scope",
    "scope_hash",
    "created_at",
    "created_by"
  ],
  "properties": {
    "approval_id": {"type": "string"},
    "case_id": {"type": "string"},
    "workflow_type": {"type": "string", "enum": ["GOV", "EXPORT", "UNKNOWN"]},
    "proposed_action": {"type": "string"},
    "business_object": {"type": "string"},
    "amount_or_price": {"type": "string"},
    "external_party": {"type": "string"},
    "expected_benefit": {"type": "string"},
    "concrete_risk": {"type": "string"},
    "recovery_rollback_path": {"type": "string"},
    "recovery_path": {"type": "string"},
    "documents_sources_used": {"type": "array", "items": {"type": "string"}},
    "confidence_score": {"type": "integer", "minimum": 0, "maximum": 100},
    "missing_information": {"type": "array", "items": {"type": "string"}},
    "approval_options": {"type": "array", "items": {"type": "string"}},
    "allowed_decisions": {"type": "array", "items": {"type": "string"}},
    "approval_status": {"type": "string"},
    "requested_at": {"type": "string"},
    "approval_timeout_at": {"type": "string"},
    "scope": {
      "type": "object",
      "required": ["case_id", "workflow_type", "proposed_action", "business_object", "amount_or_price", "external_party"]
    },
    "scope_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "created_at": {"type": "string"},
    "created_by": {"type": "string"},
    "html_path": {"type": "string"},
    "json_path": {"type": "string"}
  }
}
