{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tender-export-os.local/schemas/internal_learning_proposal.schema.json",
  "title": "Tender OS Internal Learning Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["proposal_id", "case_ids", "proposal_type", "summary", "evidence", "tests", "rollback", "actor_profile", "idempotency_key", "citations"],
  "properties": {
    "proposal_id": {"type": "string", "minLength": 1},
    "case_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "proposal_type": {"type": "string", "enum": ["memory", "skill", "rule", "prompt", "model", "source_adapter", "test"]},
    "summary": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "tests": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "rollback": {"type": "string", "minLength": 1},
    "actor_profile": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 8},
    "citations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
