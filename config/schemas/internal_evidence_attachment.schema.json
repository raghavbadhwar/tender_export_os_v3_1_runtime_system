{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tender-export-os.local/schemas/internal_evidence_attachment.schema.json",
  "title": "Tender OS Internal Evidence Attachment",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "evidence_path", "evidence_type", "actor_profile", "idempotency_key", "citations"],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "evidence_path": {"type": "string", "minLength": 1},
    "evidence_type": {"type": "string", "minLength": 1},
    "actor_profile": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 8},
    "citations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
