{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tender-export-os.local/schemas/swarm_worker_output.schema.json",
  "title": "Tender OS Structured Swarm Worker Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "case_id", "swarm_id", "worker_id", "summary", "evidence", "findings", "unknowns", "stop_reason", "approval_required", "external_actions_executed"],
  "properties": {
    "status": {"enum": ["PASS", "BLOCKED", "FAIL"]},
    "case_id": {"type": "string", "minLength": 1},
    "swarm_id": {"type": "string", "minLength": 1},
    "worker_id": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "findings": {"type": "array", "items": {"type": "object"}},
    "unknowns": {"type": "array", "items": {"type": "string"}},
    "stop_reason": {"type": "string"},
    "approval_required": {"type": "boolean"},
    "external_actions_executed": {"const": false}
  }
}
