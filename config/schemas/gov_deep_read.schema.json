{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tender Export OS GOV Deep Read Contract",
  "description": "Versioned, citation-first extraction contract for government tender documents. Raw document text is intentionally excluded.",
  "schema_version": "gov_deep_read.v1",
  "required_top_level": [
    "schema_version",
    "case_id",
    "workflow_type",
    "extraction_status",
    "generated_at",
    "source_documents",
    "facts",
    "corrigenda",
    "boq_lines",
    "ambiguous_clauses",
    "recommended_case_status",
    "external_actions_executed"
  ],
  "fact_statuses": ["EXTRACTED", "UNKNOWN", "AMBIGUOUS", "NOT_APPLICABLE"],
  "extraction_statuses": ["COMPLETE", "PARTIAL", "BLOCKED"],
  "recommended_case_statuses": ["SUPPLIER_SEARCH", "WATCHLIST", "REJECTED"],
  "required_fact_keys": [
    "buyer_name",
    "bid_number",
    "tender_title",
    "publication_date",
    "deadline_date",
    "eligibility",
    "turnover",
    "experience",
    "oem",
    "emd",
    "pbg",
    "required_documents",
    "delivery",
    "payment",
    "penalties",
    "evaluation_method",
    "reverse_auction",
    "inspection",
    "warranty"
  ],
  "citation_required_for": ["EXTRACTED", "AMBIGUOUS"],
  "unknown_reason_required_for": ["UNKNOWN", "NOT_APPLICABLE"],
  "citation_fields": ["source_path", "source_url", "page", "section"],
  "prohibited_keys": ["raw_pdf_text", "raw_full_pdf_text", "raw_html", "password", "token", "cookie", "session", "dsc", "bank_details"]
}
