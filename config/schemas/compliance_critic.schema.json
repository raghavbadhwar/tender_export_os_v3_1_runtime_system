{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tender Export OS Compliance Critic Review",
  "schema_version": "compliance_critic.v1",
  "required_fields": [
    "schema_version",
    "case_id",
    "workflow_type",
    "reviewed_at",
    "critic_required",
    "status",
    "gaps",
    "can_write_final_state",
    "external_actions_executed"
  ],
  "statuses": ["PASS_NO_CRITIC_REQUIRED", "REVIEW_REQUIRED", "BLOCKED"],
  "high_risk_requirement_types": ["scomet", "hsn_itchs", "tariff", "tax", "certificate", "destination", "origin"],
  "boundary": "Critic review only. It returns gaps and cannot write final compliance, classification, origin, tax, certificate, destination, bid, quote, or external state."
}
