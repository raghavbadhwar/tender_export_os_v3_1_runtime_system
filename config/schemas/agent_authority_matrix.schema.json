{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tender-export-os.local/schemas/agent_authority_matrix.schema.json",
  "title": "Tender Export OS Level 6 Authority Matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "schema_version",
    "policy_name",
    "owner_profile",
    "orchestrator_profile",
    "default_policy",
    "external_actions_default",
    "receipt_contracts",
    "action_classes",
    "policy_action_classes",
    "approval_required_actions",
    "prohibited_actions"
  ],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "schema_version": {"const": "authority_matrix.v1"},
    "policy_name": {"type": "string", "minLength": 1},
    "owner_profile": {"type": "string", "minLength": 1},
    "orchestrator_profile": {"type": "string", "minLength": 1},
    "default_policy": {"const": "deny"},
    "external_actions_default": {"const": false},
    "receipt_contracts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["required_fields", "external_actions_executed"],
        "properties": {
          "required_fields": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "external_actions_executed": {"const": false}
        }
      }
    },
    "action_classes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tier", "description", "external_effect", "approval_mode", "staging_profiles", "execution_profiles", "receipt_contract"],
        "properties": {
          "tier": {"type": "integer", "minimum": 0, "maximum": 5},
          "description": {"type": "string", "minLength": 1},
          "external_effect": {"type": "boolean"},
          "approval_mode": {"enum": ["not_required", "required", "prohibited"]},
          "staging_profiles": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "execution_profiles": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "receipt_contract": {"type": "string", "minLength": 1}
        }
      }
    },
    "policy_action_classes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "approval_required_actions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "prohibited_actions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
